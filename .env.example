# ---------------------------------------------------------------------------
# Sanity 内容源（全部可选）
# 复制为 .env.local 后填写。未配置时，前台自动使用仓库内的本地兜底数据，
# 页面行为与纯静态版本完全一致 —— 不会出现空白或报错。
# ---------------------------------------------------------------------------

# Sanity 项目 ID（sanity.io/manage 可查）。不要提交真实值到仓库。
VITE_SANITY_PROJECT_ID=
# 数据集，通常用 production
VITE_SANITY_DATASET=production
# GROQ API 版本，格式 YYYY-MM-DD
VITE_SANITY_API_VERSION=2024-10-01
# 是否走 Sanity CDN。生产建议 true；想更快看到新内容可设 false
VITE_SANITY_USE_CDN=true
# 前台自动重新拉取的间隔（秒）。0 = 只在加载和窗口重新聚焦时拉取
VITE_SANITY_REVALIDATE_SEC=0
# 迁移期开关：true = 本地数据与 CMS 内容并排显示（同 slug 以 CMS 为准）。
# 全部内容导入 CMS 后可设为 false，让 CMS 成为唯一数据源。
VITE_SANITY_MERGE_LOCAL=false
# 单次请求超时（毫秒），超时后自动回落本地数据
VITE_SANITY_TIMEOUT_MS=6000

# 只读令牌（Viewer 角色）。用途有二：
#   1) dataset 设为 private 时，前台用它读取已发布内容；
#   2) 配合 URL ?preview=1 以草稿视角预览未发布内容。
# 前台永远不要放 write token。
VITE_SANITY_READ_TOKEN=

# 实时更新：设为 true 且上面填了只读 Viewer Token 时，前台通过 WebSocket
# 订阅内容变更 —— 后台点「发布」后，已打开的页面会自动刷新，无需手动刷新浏览器。
# 注意：只读 Token 会出现在前端产物里，务必使用 Viewer 角色，绝不能用写入 Token。
# 不开启时退化为「页面加载 / 窗口聚焦 / 定时重取」，同样能拿到最新内容。
VITE_SANITY_REALTIME=false

# Studio 后台部署后的绝对路径，需与后台 basePath 一致
VITE_SANITY_STUDIO_BASE_PATH=/homepage/studio

# 正式站点地址，供后台「在网站预览 / 预览草稿」按钮跳转
VITE_SITE_URL=https://wxzstudio.github.io/homepage/

# Studio 后台地址（用于前台「进入后台」链接，可选）
VITE_STUDIO_URL=/studio/
